{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/mainbase", "destination": "/", "permanent": false },
    { "source": "/mainbase.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/game", "destination": "/1.1_power_mission.html" },
    { "source": "/power", "destination": "/1.1_power_mission.html" },
    { "source": "/radiation", "destination": "/5.1_Radiation_mission.html" },
    { "source": "/1.1_power.html", "destination": "/5.1_Radiation_mission.html" },
    { "source": "/meal", "destination": "/2.1_daily_meal.html" },
    { "source": "/food", "destination": "/2.1_daily_meal.html" },
    { "source": "/hydroponics", "destination": "/2.2_Hydroponics.html" },
    { "source": "/2.2_hydroponics", "destination": "/2.2_Hydroponics.html" },
    { "source": "/final-mission", "destination": "/final_mission.html" },
    { "source": "/final_mission", "destination": "/final_mission.html" },
    { "source": "/final", "destination": "/final_mission.html" },
    { "source": "/last-light", "destination": "/final_mission.html" },
    { "source": "/isru", "destination": "/isru_mission.html" },
    { "source": "/isru-mission", "destination": "/isru_mission.html" },
    { "source": "/base", "destination": "/index.html" },
    { "source": "/mainbase", "destination": "/index.html" }
  ]
}
