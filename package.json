{
  "name": "moonfall",
  "version": "1.0.0",
  "description": "MoonFall: Lunar Outpost Survival & Resource Management Simulator",
  "main": "electron-main.js",
  "author": "Team ChandraPath",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build": "echo 'Static web build ready'"
  },
  "build": {
    "appId": "com.chandrapath.moonfall",
    "productName": "MoonFall",
    "copyright": "Copyright © 2026 Team ChandraPath",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!out/**",
      "!*.bak",
      "!*.pdf",
      "!backup_logic_pdfs/**",
      "!scratch/**",
      "!.git/**",
      "!.github/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MoonFall"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
